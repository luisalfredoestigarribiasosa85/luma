<% content_for(:page_title) { "Categorías" } %>

<%= render "shared/page_header", title: "Categorías", subtitle: "#{@categories.count} categorías", action:
  link_to("Nueva categoría", new_category_path, class: button_classes) %>

<div class="<%= card_classes %> overflow-hidden">
  <% if @categories.any? %>
    <table class="w-full text-sm">
      <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
        <tr>
          <th class="px-5 py-3">Nombre</th>
          <th class="px-5 py-3">Descripción</th>
          <th class="px-5 py-3 text-right">Productos</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        <% @categories.each do |category| %>
          <tr class="transition hover:bg-raise/50">
            <td class="px-5 py-3 font-medium text-ivory"><%= category.name %></td>
            <td class="px-5 py-3 text-muted"><%= category.description.presence || "—" %></td>
            <td class="num px-5 py-3 text-right text-ivory-soft"><%= category.products.count %></td>
            <td class="px-5 py-3 text-right">
              <%= link_to "Editar", edit_category_path(category), class: "text-xs font-semibold uppercase tracking-wider text-gold hover:text-gold-bright" %>
              <%= button_to "Eliminar", category, method: :delete,
                  data: { turbo_confirm: "¿Eliminar la categoría #{category.name}?" },
                  class: "ml-3 inline text-xs font-semibold uppercase tracking-wider text-alert hover:text-alert-dark cursor-pointer" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= render "shared/empty_state", message: "No hay categorías todavía" %>
  <% end %>
</div>
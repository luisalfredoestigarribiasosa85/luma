<aside id="app-sidebar" data-sidebar-target="panel"
       class="fixed inset-y-0 left-0 z-30 flex w-72 -translate-x-full flex-col border-r border-gold-deep/20 bg-obsidian transition-transform duration-300 ease-out lg:w-64 lg:translate-x-0"
       aria-hidden="true" aria-label="Menú principal">
  <div class="ember h-[3px] w-full"></div>

  <div class="flex h-20 shrink-0 items-center justify-between gap-2 px-5">
    <div class="flex flex-col justify-center gap-1.5">
      <div class="w-fit rounded-md border border-gold-deep/30 bg-[#0e0c0a] px-1.5 py-1 shadow-[0_0_24px_rgba(212,169,79,0.14)]">
        <%= image_tag "lela.jpeg", alt: "LUMA", class: "h-7 w-auto select-none" %>
      </div>
      <p class="text-[8px] uppercase tracking-[0.28em] text-ash">Ventas e inventario</p>
    </div>
    <button data-action="click->sidebar#close" class="rounded-md p-2 text-ash transition hover:bg-ivory/5 hover:text-ivory lg:hidden" aria-label="Cerrar menú">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>

  <nav class="mt-2 flex-1 space-y-0.5 overflow-y-auto py-3 text-sm">
    <%= sidebar_link "Inicio", dashboard_index_path, icon: "dashboard" %>
    <%= sidebar_link "Ventas", sales_path, icon: "sales" %>
    <%= sidebar_link "Productos", products_path, icon: "products" %>
    <%= sidebar_link "Categorías", categories_path, icon: "categories" %>
    <%= sidebar_link "Clientes", customers_path, icon: "customers" %>
    <%= sidebar_link "Proveedores", suppliers_path, icon: "suppliers" %>
    <%= sidebar_link "Compras", purchases_path, icon: "cart" %>
    <%= sidebar_link "Gastos", expenses_path, icon: "expenses" %>
    <%= sidebar_link "Cuentas por cobrar", payments_path, icon: "balances" %>
    <%= sidebar_link "Movimientos", stock_movements_path, icon: "movements" %>
    <%= sidebar_link "Caja diaria", daily_cash_reports_path, icon: "reports" %>
    <%= sidebar_link "Reporte de ventas", sales_report_reports_path, icon: "reports" %>
    <%= sidebar_link "Reporte de ganancias", profit_reports_path, icon: "reports" %>
    <% if current_user.owner? %>
      <%= sidebar_link "Empleados", employees_path, icon: "employees" %>
      <%= sidebar_link "Configuración", edit_settings_path, icon: "settings" %>
    <% end %>
  </nav>

  <div class="shrink-0 border-t border-ivory/10 px-5 py-4">
    <p class="num text-xs font-semibold text-ivory"><%= current_account.name %></p>
    <p class="mt-0.5 text-[11px] text-ash"><%= current_user.name %> · <%= current_user.owner? ? "Dueño" : "Empleado" %></p>
    <%= button_to session_path, method: :delete, class: "mt-3 inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-ash transition hover:text-gold-bright cursor-pointer" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" /></svg>
      Cerrar sesión
    <% end %>
  </div>
</aside>

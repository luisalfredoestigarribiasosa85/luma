w<aside data-controller="sidebar" data-sidebar-target="panel"
       class="fixed inset-y-0 left-0 z-30 hidden w-64 flex-col border-r border-ink/10 bg-ink text-paper lg:flex">
  <div class="hazard h-1.5"></div>

  <div class="flex h-14 items-center gap-3 px-5">
    <%= image_tag "luma-logo.jpeg", alt: "LUMA", class: "h-20 w-20 object-contain" %>
    <div>
      <p class="font-display text-base font-bold tracking-wide text-paper">LUMA</p>
      <p class="text-[10px] uppercase tracking-[0.18em] text-paper/45">Ventas e inventario</p>
    </div>
  </div>

  <nav class="mt-2 flex-1 space-y-0.5 overflow-y-auto py-3 text-sm">
    <%= sidebar_link "Inicio", dashboard_index_path, icon: "dashboard" %>
    <%= sidebar_link "Ventas", sales_path, icon: "sales" %>
    <%= sidebar_link "Productos", products_path, icon: "products" %>
    <%= sidebar_link "Categorías", categories_path, icon: "categories" %>
    <%= sidebar_link "Clientes", customers_path, icon: "customers" %>
    <%= sidebar_link "Proveedores", suppliers_path, icon: "suppliers" %>
    <%= sidebar_link "Compras", purchases_path, icon: "cart" %>
    <%= sidebar_link "Cuentas por cobrar", payments_path, icon: "balances" %>
    <%= sidebar_link "Movimientos", stock_movements_path, icon: "movements" %>
    <%= sidebar_link "Caja diaria", daily_cash_reports_path, icon: "reports" %>
    <%= sidebar_link "Reporte de ventas", sales_report_reports_path, icon: "reports" %>
    <% if current_user.owner? %>
      <%= sidebar_link "Empleados", employees_path, icon: "employees" %>
      <%= sidebar_link "Configuración", edit_settings_path, icon: "settings" %>
    <% end %>
  </nav>

  <div class="border-t border-paper/10 px-5 py-4">
    <p class="num text-xs font-semibold text-paper"><%= current_account.name %></p>
    <p class="mt-0.5 text-[11px] text-paper/45"><%= current_user.name %> · <%= current_user.owner? ? "Dueño" : "Empleado" %></p>
    <%= button_to session_path, method: :delete, class: "mt-3 inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-wider text-paper/45 hover:text-paper cursor-pointer" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" /></svg>
      Cerrar sesión
    <% end %>
  </div>
</aside>
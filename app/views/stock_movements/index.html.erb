<% content_for(:page_title) { "Movimientos" } %>

<%= render "shared/page_header", title: "Movimientos de stock", subtitle: "Historial de entradas y salidas", action:
  link_to("Nuevo movimiento", new_stock_movement_path, class: button_classes) %>

<div class="mb-4">
  <%= form_with url: stock_movements_path, method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
    <div>
      <%= form.label :product_id, "Producto", class: label_classes %>
      <%= form.collection_select :product_id, @products, :id, :name, { include_blank: "Todos", selected: params[:product_id] }, class: field_classes %>
    </div>
    <div>
      <%= form.label :movement_type, "Tipo", class: label_classes %>
      <%= form.select :movement_type, StockMovement.movement_types.map { |k, _| [ k.titleize, k ] }, { include_blank: "Todos", selected: params[:movement_type] }, class: field_classes %>
    </div>
    <%= form.submit "Filtrar", class: "#{button_classes(:secondary)} cursor-pointer" %>
  <% end %>
</div>

<div class="<%= card_classes %> overflow-hidden">
  <% if @movements.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
          <tr>
            <th class="px-5 py-3">Fecha</th>
            <th class="px-5 py-3">Producto</th>
            <th class="px-5 py-3">Tipo</th>
            <th class="px-5 py-3 text-right">Cantidad</th>
            <th class="px-5 py-3 text-right">Stock resultante</th>
            <th class="px-5 py-3">Nota</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @movements.each do |movement| %>
            <tr class="transition hover:bg-raise/50">
              <td class="num px-5 py-3 text-muted"><%= simple_date(movement.created_at) %></td>
              <td class="px-5 py-3">
                <%= link_to movement.product.name, movement.product, class: "font-medium text-ivory hover:text-gold" %>
                <span class="num block text-xs text-faint"><%= movement.product.sku.presence || "" %></span>
              </td>
              <td class="px-5 py-3">
                <span class="<%= badge_color(movement.movement_type) %> capitalize"><%= movement.movement_type %></span>
              </td>
              <td class="num px-5 py-3 text-right font-semibold <%= movement.quantity.positive? ? "text-ok" : "text-alert" %>">
                <%= movement.signed_quantity %>
              </td>
              <td class="num px-5 py-3 text-right text-ivory-soft"><%= movement.new_quantity %></td>
              <td class="px-5 py-3 text-muted"><%= movement.note.presence || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "shared/empty_state", message: "No hay movimientos registrados" %>
  <% end %>
</div>
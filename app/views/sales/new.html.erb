<% content_for(:page_title) { "Nueva venta" } %>
<% catalog = @products.map { |p| { id: p.id, name: p.name, price: p.price, unit: p.unit, stock: p.stock } }.to_json %>

<script type="application/json" id="sale-catalog" data-turbo-cache="false"><%= raw json_escape catalog %></script>

<%= render "shared/form_errors", object: @sale %>

<%= form_with model: @sale, data: { controller: "sales", sales_stock_limit_value: true }, class: "grid items-start gap-6 xl:grid-cols-3" do |form| %>
  <div class="card p-6 xl:col-span-2">
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :customer_id, "Cliente", class: label_classes %>
        <%= form.collection_select :customer_id, @customers, :id, :name, { include_blank: "Consumidor final" }, class: field_classes %>
      </div>
      <div>
        <%= form.label :payment_method, "Forma de pago", class: label_classes %>
        <%= form.select :payment_method, payment_method_options(Sale.payment_methods), {}, class: field_classes, data: { sales_target: "paymentMethod", action: "change->sales#toggleCash" } %>
      </div>
    </div>

    <p class="eyebrow mt-7">Productos de la venta</p>

    <div class="mt-3 hidden grid-cols-12 gap-2 px-1 text-[10px] font-bold uppercase tracking-wider text-faint sm:grid">
      <div class="col-span-6">Producto</div>
      <div class="col-span-2">Cant.</div>
      <div class="col-span-2">Precio</div>
      <div class="col-span-2 text-right">Subtotal</div>
    </div>

    <div data-sales-target="lines" class="mt-2 space-y-2">
      <%= form.fields_for :items, @sale.items do |item_form| %>
        <%= render "sales/item_fields", f: item_form %>
      <% end %>
    </div>

    <button type="button" data-action="sales#addLine" class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-bronze hover:text-bronze-deep cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      Agregar producto
    </button>

    <template data-sales-target="template">
      <%= form.fields_for :items, SaleItem.new, child_index: "__INDEX__" do |item_form| %>
        <%= render "sales/item_fields", f: item_form %>
      <% end %>
    </template>

    <div class="mt-7">
      <%= form.label :note, "Nota", class: label_classes %>
      <%= form.text_area :note, rows: 2, placeholder: "Comentario interno (no afecta el total)", class: field_classes %>
    </div>
  </div>

  <div class="card overflow-hidden xl:col-span-1">
    <div class="ember h-1.5"></div>
    <div class="p-6">
      <p class="eyebrow">Resumen de la venta</p>

      <div class="mt-4 space-y-3 font-mono text-sm">
        <div class="flex justify-between">
          <span class="text-muted">Artículos</span>
          <span data-sales-target="summaryCount" class="font-semibold">0</span>
        </div>
        <div class="flex justify-between">
          <span class="text-muted">Subtotal</span>
          <span data-sales-target="summarySubtotal" class="font-semibold">0</span>
        </div>
        <div class="flex items-center justify-between gap-4">
          <span class="text-muted">Descuento</span>
          <%= form.number_field :discount, step: "0.01", min: 0, value: @sale.discount || 0,
              class: "num w-24 rounded-md border border-line-dark bg-surface px-2 py-1.5 text-right text-sm",
              data: { sales_target: "discount", action: "input->sales#recalculate" } %>
        </div>
        <div class="mt-4 flex items-end justify-between border-t border-dashed border-line-dark pt-4">
          <span class="font-display text-sm font-bold uppercase tracking-wider">Total</span>
          <span data-sales-target="summaryTotal" class="num font-display text-2xl font-bold text-bronze">0</span>
        </div>

        <div data-sales-target="cashBlock" class="hidden space-y-3 border-t border-dashed border-line-dark pt-4">
          <div class="flex items-center justify-between gap-4">
            <label for="cash-received" class="text-muted">Paga con</label>
            <input type="number" id="cash-received" min="0" step="1" inputmode="numeric" placeholder="0"
                   class="num w-32 rounded-md border border-line-dark bg-surface px-2 py-1.5 text-right text-sm"
                   data-sales-target="cashReceived" data-action="input->sales#recalculate">
          </div>
          <div class="flex items-center justify-between gap-4">
            <span class="text-muted" data-sales-target="changeLabel">Vuelto</span>
            <span data-sales-target="change" class="num font-semibold text-bronze">Gs. 0</span>
          </div>
        </div>
      </div>

      <div class="mt-7 flex flex-col gap-3">
        <%= form.submit "Registrar venta", class: "#{button_classes} w-full", data: { turbo_submits_with: "Guardando…" } %>
        <%= link_to "Cancelar", sales_path, class: "#{button_classes(:secondary)} w-full" %>
      </div>

      <p class="mt-5 border-t border-line pt-4 text-xs leading-relaxed text-faint">El precio se carga automáticamente al elegir el producto y el stock se descuenta al registrar la venta.</p>
    </div>
  </div>
<% end %>
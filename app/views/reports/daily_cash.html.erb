<% content_for(:page_title) { "Caja diaria" } %>

<%= render "shared/page_header", title: "Caja diaria", subtitle: simple_date(@date) %>

<div class="mb-4">
  <%= form_with url: daily_cash_reports_path, method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
    <div>
      <%= form.label :date, "Fecha", class: label_classes %>
      <%= form.date_field :date, value: params[:date], class: field_classes %>
    </div>
    <%= form.submit "Ver", class: "#{button_classes(:secondary)} cursor-pointer" %>
  <% end %>
</div>

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Ventas del día</p>
    <p class="num font-display mt-2 text-2xl font-bold text-ink"><%= @sale_count %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Ingreso total</p>
    <p class="num font-display mt-2 text-2xl font-bold text-ok"><%= money(@total) %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Descuentos aplicados</p>
    <p class="num font-display mt-2 text-2xl font-bold text-alert"><%= money(@discount_total) %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Clientes con compra</p>
    <p class="num font-display mt-2 text-2xl font-bold text-ink"><%= @customer_count %></p>
  </div>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-2">
  <div class="<%= card_classes %> overflow-hidden">
    <div class="border-b border-line px-5 py-4">
      <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ink">Desglose por forma de pago</h3>
    </div>
    <table class="w-full text-sm">
      <tbody class="divide-y divide-line">
        <% @by_payment.each do |method, amount| %>
          <tr class="transition hover:bg-raise/50">
            <td class="px-5 py-3 text-ink-soft"><%= payment_method_label(method) %></td>
            <td class="num px-5 py-3 text-right font-semibold text-ink"><%= money(amount) %></td>
          </tr>
        <% end %>
        <tr class="border-t-2 border-line bg-raise/50">
          <td class="px-5 py-3 font-display text-sm font-bold uppercase tracking-wide text-ink">Total</td>
          <td class="num px-5 py-3 text-right font-display text-base font-bold text-ok"><%= money(@total) %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="<%= card_classes %> overflow-hidden">
    <div class="flex items-center justify-between border-b border-line px-5 py-4">
      <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ink">Gastos del día</h3>
      <%= link_to "Nuevo gasto", new_expense_path, class: "text-xs font-semibold uppercase tracking-wider text-bronze hover:text-bronze-deep" %>
    </div>
    <% if @day_expenses.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
            <tr>
              <th class="px-5 py-3">Concepto</th>
              <th class="px-5 py-3">Categoría</th>
              <th class="px-5 py-3">Método</th>
              <th class="px-5 py-3 text-right">Monto</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% @day_expenses.each do |expense| %>
              <tr class="transition hover:bg-raise/50">
                <td class="px-5 py-3 font-medium text-ink"><%= expense.description %></td>
                <td class="px-5 py-3 text-muted"><%= expense.category_label %></td>
                <td class="px-5 py-3 text-ink-soft"><%= payment_method_label(expense.payment_method) %></td>
                <td class="num px-5 py-3 text-right font-semibold text-alert">− <%= money(expense.amount) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <dl class="border-t border-line bg-raise/50 px-5 py-4 text-sm font-mono">
        <div class="flex justify-between"><dt class="text-muted">Ingresos en efectivo</dt><dd class="text-ok"><%= money(@cash_income) %></dd></div>
        <div class="flex justify-between"><dt class="text-muted">− Gastos en efectivo</dt><dd class="text-alert"><%= money(@cash_expenses) %></dd></div>
        <div class="mt-2 flex justify-between border-t border-dashed border-line-dark pt-2 font-display text-base font-bold text-ink"><dt>Caja esperada en efectivo</dt><dd class="text-bronze"><%= money(@cash_expected) %></dd></div>
      </dl>
      <p class="border-t border-line px-5 py-3 text-[11px] text-faint">Solo los gastos pagados en efectivo descuentan la caja. Los demás quedan registrados para el <%= link_to "reporte de ganancias", profit_reports_path, class: "text-bronze hover:text-bronze-deep" %>.</p>
    <% else %>
      <%= render "shared/empty_state", message: "No hay gastos en esta fecha" %>
    <% end %>
  </div>

  <div class="<%= card_classes %> overflow-hidden">
    <div class="border-b border-line px-5 py-4">
      <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ink">Ventas del día</h3>
    </div>
    <% if @sales.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
            <tr>
              <th class="px-5 py-3">N°</th>
              <th class="px-5 py-3">Hora</th>
              <th class="px-5 py-3">Cliente</th>
              <th class="px-5 py-3">Pago</th>
              <th class="px-5 py-3 text-right">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% @sales.each do |sale| %>
              <tr class="transition hover:bg-raise/50">
                <td class="num px-5 py-3 text-faint">#<%= sale.number %></td>
                <td class="num px-5 py-3 text-muted"><%= sale.created_at.strftime("%H:%M") %></td>
                <td class="px-5 py-3"><%= link_to (sale.customer&.name || "Consumidor final"), sale, class: "font-medium text-ink hover:text-bronze" %></td>
                <td class="px-5 py-3 text-ink-soft"><%= payment_method_label(sale.payment_method) %></td>
                <td class="num px-5 py-3 text-right font-semibold text-ink"><%= money(sale.total) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "No hubo ventas en esta fecha" %>
    <% end %>
  </div>
</div>
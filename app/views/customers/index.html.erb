<% content_for(:page_title) { "Clientes" } %>

<%= render "shared/page_header", title: "Clientes", subtitle: "#{@customers.count} clientes", action:
  link_to("Nuevo cliente", new_customer_path, class: button_classes) %>

<div class="mb-4">
  <%= form_with url: customers_path, method: :get, class: "flex max-w-md gap-2" do |form| %>
    <%= form.text_field :q, value: params[:q], placeholder: "Buscar por nombre o documento…", class: field_classes %>
    <%= form.submit "Buscar", class: "#{button_classes(:secondary)} cursor-pointer" %>
  <% end %>
</div>

<div class="<%= card_classes %> overflow-hidden">
  <% if @customers.any? %>
    <table class="w-full text-sm">
      <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
        <tr>
          <th class="px-5 py-3">Nombre</th>
          <th class="px-5 py-3">Documento</th>
          <th class="px-5 py-3">Teléfono</th>
          <th class="px-5 py-3 text-right">Compras</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        <% @customers.each do |customer| %>
          <tr class="transition hover:bg-raise/50">
            <td class="px-5 py-3">
              <%= link_to customer.name, customer, class: "font-medium text-ivory hover:text-gold" %>
            </td>
            <td class="num px-5 py-3 text-xs text-faint"><%= customer.document_number.presence || "—" %></td>
            <td class="px-5 py-3 text-muted"><%= customer.phone.presence || "—" %></td>
            <td class="num px-5 py-3 text-right text-ivory-soft"><%= customer.sales.count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= render "shared/empty_state", message: "No hay clientes todavía" %>
  <% end %>
</div>
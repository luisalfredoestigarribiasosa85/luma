<% content_for(:page_title) { "Iniciar sesión" } %>

<div class="grid min-h-screen lg:grid-cols-2">
  <%= render "shared/brand_panel" %>

  <div class="flex items-center justify-center px-5 py-12 sm:px-8">
    <div class="w-full max-w-sm reveal">
      <p class="eyebrow">Bienvenido de nuevo</p>
      <h1 class="font-display mt-2 text-3xl font-bold text-ivory">Iniciar sesión</h1>
      <div class="ember mt-4 h-px w-20"></div>

      <%= form_with url: session_path, method: :post, class: "mt-7 space-y-5" do |form| %>
        <div>
          <%= form.label :email, "Email", class: label_classes %>
          <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: field_classes %>
        </div>
        <div>
          <%= form.label :password, "Contraseña", class: label_classes %>
          <%= form.password_field :password, autocomplete: "current-password", required: true, class: field_classes %>
        </div>
        <%= form.submit "Ingresar", class: "#{button_classes} w-full" %>
      <% end %>

      <p class="mt-8 text-center text-sm text-muted">
        ¿No tenés cuenta? <%= link_to "Crear cuenta", signup_path, class: "font-semibold text-gold hover:text-gold-bright" %>
      </p>
    </div>
  </div>
</div>

<% content_for(:page_title) { "Revisar importación" } %>

<%= render "shared/page_header", title: "Revisar importación", subtitle: "Validación de tu archivo CSV" %>

<% valid_count = @importer.valid_rows.count %>
<% error_rows = @importer.rows.select { |r| r[:errors].present? } %>

<div class="grid gap-4 sm:grid-cols-3">
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Filas totales</p>
    <p class="num font-display mt-2 text-2xl font-bold text-ivory"><%= @importer.rows.count %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Correctas (se importarán)</p>
    <p class="num font-display mt-2 text-2xl font-bold text-ok"><%= valid_count %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Con errores</p>
    <p class="num font-display mt-2 text-2xl font-bold <%= error_rows.any? ? "text-alert" : "text-ivory" %>"><%= error_rows.count %></p>
  </div>
</div>

<div class="mt-6 <%= card_classes %> overflow-hidden">
  <div class="border-b border-line px-5 py-4">
    <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ivory">Vista previa</h3>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
        <tr>
          <th class="px-5 py-3">Fila</th>
          <th class="px-5 py-3">Nombre</th>
          <th class="px-5 py-3">Categoría</th>
          <th class="px-5 py-3 text-right">Costo</th>
          <th class="px-5 py-3 text-right">Precio</th>
          <th class="px-5 py-3 text-right">Stock</th>
          <th class="px-5 py-3">Estado</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        <% @importer.rows.first(200).each do |row| %>
          <tr class="<%= row[:errors].present? ? "bg-alert-soft/50" : "" %>">
            <td class="num px-5 py-2.5 text-faint"><%= row[:index] %></td>
            <td class="px-5 py-2.5 font-medium text-ivory"><%= row[:attrs][ "nombre" ].presence || "—" %></td>
            <td class="px-5 py-2.5 text-ivory-soft"><%= row[:attrs][ "categoria" ].presence || "" %></td>
            <td class="num px-5 py-2.5 text-right text-ivory-soft"><%= money(row[:attrs][ "costo" ].to_i) %></td>
            <td class="num px-5 py-2.5 text-right text-ivory-soft"><%= money(row[:attrs][ "precio" ].to_i) %></td>
            <td class="num px-5 py-2.5 text-right text-ivory-soft"><%= row[:attrs][ "stock" ] %></td>
            <td class="px-5 py-2.5">
              <% if row[:errors].present? %>
                <span class="badge badge-alert" title="<%= row[:errors].join(", ") %>">Error</span>
              <% else %>
                <span class="badge badge-ok">Ok</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @importer.rows.count > 200 %>
    <p class="border-t border-line px-5 py-3 text-xs text-muted">Mostrando las primeras 200 filas de <%= @importer.rows.count %>.</p>
  <% end %>
</div>

<% if error_rows.any? %>
  <div class="mt-4 rounded-lg border border-warn/30 bg-warn-soft px-4 py-3 text-sm text-warn">
    <p class="font-display font-bold uppercase tracking-wide">Resumen de errores por fila</p>
    <ul class="mt-1 list-disc space-y-0.5 pl-5">
      <% error_rows.first(20).each do |row| %>
        <li><span class="num text-xs">Fila <%= row[:index] %></span> — <%= row[:errors].join(", ") %></li>
      <% end %>
      <% if error_rows.count > 20 %>
        <li>… y <%= error_rows.count - 20 %> filas más.</li>
      <% end %>
    </ul>
    <p class="mt-2 text-xs">Las filas con errores se omitirán; el resto se importará correctamente.</p>
  </div>
<% end %>

<div class="mt-6 flex flex-wrap items-center justify-end gap-3">
  <%= link_to "Volver", new_import_path, class: button_classes(:secondary) %>
  <%= form_with url: imports_path, class: "inline-flex gap-3" do |form| %>
    <%= form.hidden_field :confirm, value: "1" %>
    <%= form.hidden_field :csv_content, value: @importer.original_content %>
    <%= form.submit "Importar #{valid_count} producto(s)", class: button_classes, disabled: valid_count.zero?, data: { turbo_submits_with: "Importando…" } %>
  <% end %>
</div>
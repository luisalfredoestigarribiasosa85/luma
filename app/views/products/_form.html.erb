<%= render "shared/form_errors", object: @product %>

<div class="grid gap-6 xl:grid-cols-3">
  <div class="<%= card_classes %> p-6 xl:col-span-2">
    <%= form_with model: @product, class: "space-y-4" do |form| %>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :name, "Nombre", class: label_classes %>
          <%= form.text_field :name, required: true, class: field_classes, placeholder: "Ej: Remera oversized" %>
        </div>
        <div>
          <%= form.label :sku, "Código / SKU", class: label_classes %>
          <%= form.text_field :sku, class: field_classes, placeholder: "TAL-13" %>
        </div>
      </div>

      <div>
        <%= form.label :category_id, "Categoría", class: label_classes %>
        <%= form.collection_select :category_id, current_account.categories.order(:name), :id, :name, { include_blank: "Sin categoría" }, class: field_classes %>
      </div>

      <div>
        <%= form.label :description, "Descripción", class: label_classes %>
        <%= form.text_area :description, rows: 3, class: field_classes %>
      </div>

      <div class="grid gap-4 sm:grid-cols-4">
        <div>
          <%= form.label :cost_price, "Costo", class: label_classes %>
          <%= form.number_field :cost_price, step: "0.01", min: 0, class: "field num" %>
        </div>
        <div>
          <%= form.label :price, "Precio de venta", class: label_classes %>
          <%= form.number_field :price, step: "0.01", min: 0, class: "field num" %>
        </div>
        <div>
          <%= form.label :stock, "Stock inicial", class: label_classes %>
          <%= form.number_field :stock, min: 0, class: "field num" %>
        </div>
        <div>
          <%= form.label :min_stock, "Stock mínimo", class: label_classes %>
          <%= form.number_field :min_stock, min: 0, class: "field num" %>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :unit, "Unidad", class: label_classes %>
          <%= form.select :unit, %w[unidad par caja kg metro litro docena], {}, class: field_classes %>
        </div>
        <div class="flex items-end pb-2">
          <label class="inline-flex items-center gap-2.5 text-sm font-medium text-ink-soft">
            <%= form.check_box :active, class: "h-4 w-4 rounded border-line-dark accent-hazard" %>
            Producto activo (visible en ventas)
          </label>
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 pt-2">
        <%= link_to "Cancelar", products_path, class: button_classes(:secondary) %>
        <%= form.submit @product.persisted? ? "Guardar cambios" : "Crear producto", class: button_classes %>
      </div>
    <% end %>
  </div>

  <div class="<%= card_classes %> h-fit p-6">
    <div class="hazard mb-4 h-1 w-10"></div>
    <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ink">Ayuda</h3>
    <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-muted">
      <li><strong class="text-ink">Costo:</strong> se usa para calcular la utilidad de las ventas.</li>
      <li><strong class="text-ink">Stock inicial:</strong> genera un movimiento de ajuste al crear el producto.</li>
      <li><strong class="text-ink">Stock mínimo:</strong> al llegar a ese nivel, el producto se marca como stock bajo.</li>
    </ul>
  </div>
</div>
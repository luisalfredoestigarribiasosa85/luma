<% content_for(:page_title) { "Caja diaria" } %>

<%= render "shared/page_header", title: "Caja diaria", subtitle: simple_date(@date) %>

<div class="mb-4">
  <%= form_with url: daily_cash_reports_path, method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
    <div>
      <%= form.label :date, "Fecha", class: label_classes %>
      <%= form.date_field :date, value: params[:date], class: field_classes %>
    </div>
    <%= form.submit "Ver", class: "#{button_classes(:secondary)} cursor-pointer" %>
  <% end %>
</div>

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Ventas del día</p>
    <p class="num font-display mt-2 text-2xl font-bold text-ink"><%= @sale_count %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Ingreso total</p>
    <p class="num font-display mt-2 text-2xl font-bold text-ok"><%= money(@total) %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Descuentos aplicados</p>
    <p class="num font-display mt-2 text-2xl font-bold text-alert"><%= money(@discount_total) %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Clientes con compra</p>
    <p class="num font-display mt-2 text-2xl font-bold text-ink"><%= @customer_count %></p>
  </div>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-2">
  <div class="<%= card_classes %> overflow-hidden">
    <div class="border-b border-line px-5 py-4">
      <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ink">Desglose por forma de pago</h3>
    </div>
    <table class="w-full text-sm">
      <tbody class="divide-y divide-line">
        <% @by_payment.each do |method, amount| %>
          <tr class="transition hover:bg-raise/50">
            <td class="px-5 py-3 text-ink-soft"><%= payment_method_label(method) %></td>
            <td class="num px-5 py-3 text-right font-semibold text-ink"><%= money(amount) %></td>
          </tr>
        <% end %>
        <tr class="border-t-2 border-line bg-raise/50">
          <td class="px-5 py-3 font-display text-sm font-bold uppercase tracking-wide text-ink">Total</td>
          <td class="num px-5 py-3 text-right font-display text-base font-bold text-ok"><%= money(@total) %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="<%= card_classes %> overflow-hidden">
    <div class="flex items-center justify-between border-b border-line px-5 py-4">
      <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ink">Movimientos del día</h3>
      <%= link_to "Nuevo gasto", new_expense_path, class: "text-xs font-semibold uppercase tracking-wider text-bronze hover:text-bronze-deep" %>
    </div>
    <% if @day_expenses.any? || @day_returns.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
            <tr>
              <th class="px-5 py-3">Concepto</th>
              <th class="px-5 py-3">Detalle</th>
              <th class="px-5 py-3">Método / Categoría</th>
              <th class="px-5 py-3 text-right">Monto</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% @day_expenses.each do |expense| %>
              <tr class="transition hover:bg-raise/50">
                <td class="px-5 py-3 font-medium text-ink"><%= expense.description %></td>
                <td class="px-5 py-3 text-muted">Gasto</td>
                <td class="px-5 py-3 text-ink-soft"><%= payment_method_label(expense.payment_method) %> · <%= expense.category_label %></td>
                <td class="num px-5 py-3 text-right font-semibold text-alert">− <%= money(expense.amount) %></td>
              </tr>
            <% end %>
            <% @day_returns.each do |refund| %>
              <tr class="transition hover:bg-raise/50">
                <td class="px-5 py-3 font-medium text-ink">Reembolso venta #<%= refund.sale.number %></td>
                <td class="px-5 py-3 text-muted">Devolución</td>
                <td class="px-5 py-3 text-ink-soft"><%= refund.refund_method_label %></td>
                <td class="num px-5 py-3 text-right font-semibold text-alert">− <%= money(refund.amount) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
    <dl class="border-t border-line bg-raise/50 px-5 py-4 text-sm font-mono">
      <div class="flex justify-between"><dt class="text-muted">Ingresos en efectivo</dt><dd class="text-ok"><%= money(@cash_income) %></dd></div>
      <div class="flex justify-between"><dt class="text-muted">− Gastos en efectivo</dt><dd class="text-alert"><%= money(@cash_expenses) %></dd></div>
      <div class="flex justify-between"><dt class="text-muted">− Reembolsos en efectivo</dt><dd class="text-alert"><%= money(@cash_refunds) %></dd></div>
      <div class="flex justify-between"><dt class="text-muted">− Compras en efectivo del día</dt><dd class="text-alert"><%= money(@day_cash_purchases) %></dd></div>
      <div class="flex justify-between"><dt class="text-muted">− Pagos a proveedores en efectivo</dt><dd class="text-alert"><%= money(@day_supplier_payments_cash) %></dd></div>
      <div class="mt-2 flex justify-between border-t border-dashed border-line-dark pt-2 font-display text-base font-bold text-ink"><dt>Caja esperada en efectivo</dt><dd class="text-bronze"><%= money(@cash_expected) %></dd></div>
    </dl>
    <p class="border-t border-line px-5 py-3 text-[11px] text-faint">Solo los movimientos en efectivo descuentan la caja (tarjeta/transferencia no tocan efectivo). Los demás quedan en el <%= link_to "reporte de ganancias", profit_reports_path, class: "text-bronze hover:text-bronze-deep" %>.</p>
  </div>

  <div class="<%= card_classes %> overflow-hidden">
    <div class="border-b border-line px-5 py-4">
      <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ink">Ventas del día</h3>
    </div>
    <% if @sales.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
            <tr>
              <th class="px-5 py-3">N°</th>
              <th class="px-5 py-3">Hora</th>
              <th class="px-5 py-3">Cliente</th>
              <th class="px-5 py-3">Pago</th>
              <th class="px-5 py-3 text-right">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% @sales.each do |sale| %>
              <tr class="transition hover:bg-raise/50">
                <td class="num px-5 py-3 text-faint">#<%= sale.number %></td>
                <td class="num px-5 py-3 text-muted"><%= sale.created_at.strftime("%H:%M") %></td>
                <td class="px-5 py-3"><%= link_to (sale.customer&.name || "Consumidor final"), sale, class: "font-medium text-ink hover:text-bronze" %></td>
                <td class="px-5 py-3 text-ink-soft"><%= payment_method_label(sale.payment_method) %></td>
                <td class="num px-5 py-3 text-right font-semibold text-ink"><%= money(sale.total) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "No hubo ventas en esta fecha" %>
    <% end %>
  </div>
</div>

<div class="mt-6 <%= card_classes %> p-6">
  <div class="flex items-center justify-between gap-4">
    <div>
      <p class="eyebrow">Arqueo de caja</p>
      <h3 class="font-display mt-1 text-sm font-bold uppercase tracking-wide text-ink">Conteo físico del cierre (<%= simple_date(@date) %>)</h3>
    </div>
    <%= link_to "Historial", cash_counts_path, class: "text-xs font-semibold uppercase tracking-wider text-bronze hover:text-bronze-deep" %>
  </div>

  <% if @cash_count %>
    <div class="mt-5 grid gap-4 sm:grid-cols-3">
      <div>
        <p class="text-xs text-muted">Caja esperada</p>
        <p class="num mt-1 text-xl font-bold text-ink"><%= money(@cash_count.expected) %></p>
      </div>
      <div>
        <p class="text-xs text-muted">Contada físicamente</p>
        <p class="num mt-1 text-xl font-bold text-ink"><%= money(@cash_count.counted) %></p>
      </div>
      <div>
        <p class="text-xs text-muted">Diferencia</p>
        <p class="num mt-1 text-xl font-bold <%= @cash_count.difference.zero? ? "text-ok" : (@cash_count.difference.positive? ? "text-bronze" : "text-alert") %>">
          <%= @cash_count.difference.negative? ? "−" : "+" %><%= money(@cash_count.difference.abs) %>
        </p>
      </div>
    </div>
    <p class="mt-4 text-xs text-muted">Registró <%= @cash_count.user&.name || "—" %> · <%= simple_date(@cash_count.created_at) %><% if @cash_count.note.present? %> · <%= @cash_count.note %><% end %></p>
  <% else %>
    <%= form_with url: cash_counts_path, method: :post, class: "mt-5 flex flex-wrap items-end gap-4" do |form| %>
      <%= form.hidden_field :date, value: @date %>
      <div>
        <%= form.label :counted, "Contado físico (Gs.)", class: label_classes %>
        <%= form.number_field :counted, step: "0.01", min: 0, required: true, class: "#{field_classes} num w-40", placeholder: "0" %>
      </div>
      <div class="flex-1 min-w-48">
        <%= form.label :note, "Nota (opcional)", class: label_classes %>
        <%= form.text_field :note, placeholder: "Observación del cierre…", class: field_classes %>
      </div>
      <%= form.submit "Registrar arqueo", class: "#{button_classes} cursor-pointer" %>
    <% end %>
    <p class="mt-3 text-xs text-muted">Se congela la caja esperada del momento (<%= money(@cash_expected) %>) al registrar el arqueo.</p>
  <% end %>
</div>
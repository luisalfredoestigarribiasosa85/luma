<% content_for(:page_title) { "Compras" } %>

<%= render "shared/page_header", title: "Compras", subtitle: "Compras a proveedores", action:
  link_to("Nueva compra", new_purchase_path, class: button_classes) %>

<div class="mb-4">
  <%= form_with url: purchases_path, method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
    <div>
      <%= form.label :from, "Desde", class: label_classes %>
      <%= form.date_field :from, value: params[:from], class: field_classes %>
    </div>
    <div>
      <%= form.label :to, "Hasta", class: label_classes %>
      <%= form.date_field :to, value: params[:to], class: field_classes %>
    </div>
    <div>
      <%= form.label :supplier_id, "Proveedor", class: label_classes %>
      <%= form.collection_select :supplier_id, @suppliers, :id, :name, { include_blank: "Todos", selected: params[:supplier_id] }, class: field_classes %>
    </div>
    <%= form.submit "Filtrar", class: "#{button_classes(:secondary)} cursor-pointer" %>
    <%= link_to "Limpiar", purchases_path, class: "text-xs font-semibold uppercase tracking-wider text-gold hover:text-gold-bright" %>
  <% end %>
</div>

<div class="<%= card_classes %> overflow-hidden">
  <% if @purchases.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
          <tr>
            <th class="px-5 py-3">N°</th>
            <th class="px-5 py-3">Fecha</th>
            <th class="px-5 py-3">Proveedor</th>
            <th class="px-5 py-3 text-right">Total</th>
            <th class="px-5 py-3 text-right"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @purchases.each do |purchase| %>
            <tr class="transition hover:bg-raise/50">
              <td class="num px-5 py-3 text-faint">#<%= purchase.number %></td>
              <td class="num px-5 py-3"><%= simple_date(purchase.created_at) %></td>
              <td class="px-5 py-3 font-medium"><%= purchase.supplier&.name || "—" %></td>
              <td class="num px-5 py-3 text-right font-semibold"><%= money(purchase.total) %></td>
              <td class="px-5 py-3 text-right">
                <%= link_to "Ver", purchase, class: "text-xs font-semibold uppercase tracking-wider text-gold hover:text-gold-bright" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "shared/empty_state", message: "No hay compras registradas" %>
  <% end %>
</div>
<% content_for(:page_title) { "Cuentas por cobrar" } %>

<%= render "shared/page_header", title: "Cuentas por cobrar", subtitle: "Pagos de clientes",
  action: link_to("Registrar pago", new_payment_path, class: button_classes) %>

<div class="mb-4">
  <%= form_with url: payments_path, method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
    <div>
      <%= form.label :from, "Desde", class: label_classes %>
      <%= form.date_field :from, value: params[:from], class: field_classes %>
    </div>
    <div>
      <%= form.label :to, "Hasta", class: label_classes %>
      <%= form.date_field :to, value: params[:to], class: field_classes %>
    </div>
    <div>
      <%= form.label :customer_id, "Cliente", class: label_classes %>
      <%= form.collection_select :customer_id, @customers, :id, :name, { include_blank: "Todos", selected: params[:customer_id] }, class: field_classes %>
    </div>
    <%= form.submit "Filtrar", class: "#{button_classes(:secondary)} cursor-pointer" %>
    <%= link_to "Limpiar", payments_path, class: "text-xs font-semibold uppercase tracking-wider text-gold hover:text-gold-bright" %>
  <% end %>
</div>

<% if @payments.any? %>
  <div class="mb-4 grid gap-4 sm:grid-cols-2">
    <div class="<%= card_classes %> p-5">
      <p class="eyebrow">Pagos registrados</p>
      <p class="num font-display mt-1 text-2xl font-bold text-ivory"><%= @payments.count %></p>
    </div>
    <div class="<%= card_classes %> p-5">
      <p class="eyebrow">Total cobrado</p>
      <p class="num font-display mt-1 text-2xl font-bold text-ok"><%= money(@payments.sum(:amount)) %></p>
    </div>
  </div>

  <div class="<%= card_classes %> overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
          <tr>
            <th class="px-5 py-3">Fecha</th>
            <th class="px-5 py-3">Cliente</th>
            <th class="px-5 py-3">Venta</th>
            <th class="px-5 py-3">Pago</th>
            <th class="px-5 py-3 text-right">Monto</th>
            <th class="px-5 py-3">Registró</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @payments.each do |payment| %>
            <tr class="transition hover:bg-raise/50">
              <td class="num px-5 py-3 text-muted"><%= simple_date(payment.created_at) %></td>
              <td class="px-5 py-3 font-medium text-ivory"><%= payment.customer.name %></td>
              <td class="px-5 py-3"><%= link_to "##{payment.sale.number}", sale_path(payment.sale), class: "num text-xs text-faint hover:text-gold" %></td>
              <td class="px-5 py-3 capitalize text-ivory-soft"><%= payment.payment_method %></td>
              <td class="num px-5 py-3 text-right font-semibold text-ok"><%= money(payment.amount) %></td>
              <td class="px-5 py-3 text-muted"><%= payment.user&.name || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <%= render "shared/empty_state", message: "No hay pagos registrados en este rango" %>
<% end %>
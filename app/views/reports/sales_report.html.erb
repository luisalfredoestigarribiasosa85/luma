<% content_for(:page_title) { "Reporte de ventas" } %>

<%= render "shared/page_header",
  title: "Reporte de ventas",
  subtitle: "del #{simple_date(@from)} al #{simple_date(@to)}",
  action: link_to("Exportar CSV", sales_report_reports_path(from: @from, to: @to, format: :csv), class: button_classes(:secondary)) %>

<div class="mb-4">
  <%= form_with url: sales_report_reports_path, method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
    <div>
      <%= form.label :from, "Desde", class: label_classes %>
      <%= form.date_field :from, value: @from, class: field_classes %>
    </div>
    <div>
      <%= form.label :to, "Hasta", class: label_classes %>
      <%= form.date_field :to, value: @to, class: field_classes %>
    </div>
    <%= form.submit "Filtrar", class: "#{button_classes(:secondary)} cursor-pointer" %>
  <% end %>
</div>

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Ventas realizadas</p>
    <p class="num font-display mt-2 text-2xl font-bold text-ivory"><%= @sale_count %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Ingreso total</p>
    <p class="num font-display mt-2 text-2xl font-bold text-ivory"><%= money(@total) %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Unidades vendidas</p>
    <p class="num font-display mt-2 text-2xl font-bold text-ivory"><%= @unit_count %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Ganancia bruta</p>
    <p class="num font-display mt-2 text-2xl font-bold text-ok"><%= money(@profit) %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Margen</p>
    <p class="num font-display mt-2 text-2xl font-bold text-ok"><%= number_to_percentage(@margin, precision: 1) %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="eyebrow">Descuentos aplicados</p>
    <p class="num font-display mt-2 text-2xl font-bold text-alert"><%= money(@discount_total) %></p>
  </div>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-2">
  <div class="<%= card_classes %> overflow-hidden">
    <div class="border-b border-line px-5 py-4">
      <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ivory">Ventas por día</h3>
    </div>
    <% if @daily_totals.any? %>
      <% max = @daily_totals.map(&:last).max.to_f %>
      <div class="p-5">
        <dl class="space-y-3">
          <% @daily_totals.each do |day, total| %>
            <div>
              <div class="flex items-center justify-between text-sm">
                <dt class="font-medium text-ivory-soft"><%= I18n.l(day, format: :short) %></dt>
                <dd class="num font-semibold text-ivory"><%= money(total) %></dd>
              </div>
              <% width = max.zero? ? 0 : (total.to_f / max * 100) %>
              <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-line">
                <div class="h-full rounded-full bg-gold" style="width: <%= width %>%"></div>
              </div>
            </div>
          <% end %>
        </dl>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "No hubo ventas en este período" %>
    <% end %>
  </div>

  <div class="<%= card_classes %> overflow-hidden">
    <div class="border-b border-line px-5 py-4">
      <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ivory">Top 10 productos por ganancia</h3>
    </div>
    <% if @top_products.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
            <tr>
              <th class="px-5 py-3">#</th>
              <th class="px-5 py-3">Producto</th>
              <th class="px-5 py-3 text-right">Unid.</th>
              <th class="px-5 py-3 text-right">Total</th>
              <th class="px-5 py-3 text-right">Ganancia</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% @top_products.each_with_index do |row, index| %>
              <tr class="transition hover:bg-raise/50">
                <td class="num px-5 py-3 text-faint"><%= index + 1 %></td>
                <td class="px-5 py-3 font-medium text-ivory"><%= row.name %></td>
                <td class="num px-5 py-3 text-right text-ivory-soft"><%= row.total_quantity %></td>
                <td class="num px-5 py-3 text-right font-semibold text-ivory"><%= money(row.total_amount) %></td>
                <td class="num px-5 py-3 text-right font-semibold text-ok"><%= money(row.total_profit) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "Sin ventas para mostrar" %>
    <% end %>
  </div>

  <div class="<%= card_classes %> overflow-hidden">
    <div class="border-b border-line px-5 py-4">
      <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ivory">Ventas por categoría</h3>
    </div>
    <% if @by_category.any? %>
      <table class="w-full text-sm">
        <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
          <tr>
            <th class="px-5 py-3">Categoría</th>
            <th class="px-5 py-3 text-right">Unid.</th>
            <th class="px-5 py-3 text-right">Total</th>
            <th class="px-5 py-3 text-right">Ganancia</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @by_category.each do |row| %>
            <tr class="transition hover:bg-raise/50">
              <td class="px-5 py-3 text-ivory-soft"><%= row.name %></td>
              <td class="num px-5 py-3 text-right text-muted"><%= row.total_quantity %></td>
              <td class="num px-5 py-3 text-right font-semibold text-ivory"><%= money(row.total_amount) %></td>
              <td class="num px-5 py-3 text-right font-semibold text-ok"><%= money(row.total_profit) %></td>
            </tr>
          <% end %>
          <tr class="border-t-2 border-line bg-raise/50">
            <td class="px-5 py-3 font-display text-sm font-bold uppercase tracking-wide text-ivory">Total</td>
            <td class="num px-5 py-3 text-right text-muted"><%= @unit_count %></td>
            <td class="num px-5 py-3 text-right font-display text-base font-bold text-ivory"><%= money(@total) %></td>
            <td class="num px-5 py-3 text-right font-display text-base font-bold text-ok"><%= money(@profit) %></td>
          </tr>
        </tbody>
      </table>
    <% else %>
      <%= render "shared/empty_state", message: "Sin ventas en este período" %>
    <% end %>
  </div>

  <div class="<%= card_classes %> overflow-hidden">
    <div class="border-b border-line px-5 py-4">
      <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ivory">Ventas por vendedor</h3>
    </div>
    <% if @by_seller.any? %>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-line">
          <% @by_seller.each do |name, total| %>
            <tr class="transition hover:bg-raise/50">
              <td class="px-5 py-3 text-ivory-soft"><%= name || "Sin vendedor" %></td>
              <td class="num px-5 py-3 text-right font-semibold text-ivory"><%= money(total) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <%= render "shared/empty_state", message: "Sin ventas en este período" %>
    <% end %>
  </div>
</div>
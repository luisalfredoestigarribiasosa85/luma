<% content_for(:page_title) { "Importar productos" } %>

<%= render "shared/page_header", title: "Importar productos", subtitle: "Cargá tus productos desde Excel (.xlsx/.xls) o CSV" %>

<div class="max-w-2xl <%= card_classes %> p-6">
  <%= render "shared/form_errors", object: @product if @product %>

  <p class="text-sm leading-relaxed text-ink-soft">
    Subí tu <strong class="text-ink">Excel</strong> (.xlsx / .xls) o un archivo <strong class="text-ink">CSV</strong> con tus productos.
    Cada fila es un producto. Se toma la <strong class="text-ink">primera hoja</strong> y la primera fila debe ser la de <strong class="text-ink">encabezados</strong>.
    Descargá la <strong class="text-ink">plantilla</strong> para ver las columnas correctas.
  </p>

  <div class="mt-4">
    <%= link_to(template_imports_path, class: "inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-hazard hover:text-hazard-dark") do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
      plantilla_productos.csv
    <% end %>
  </div>

  <h4 class="font-display mt-6 text-sm font-bold uppercase tracking-wide text-ink">Columnas esperadas</h4>
  <div class="mt-2 overflow-hidden rounded-lg border border-line">
    <table class="w-full text-sm">
      <thead class="bg-paper/60 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
        <tr>
          <th class="px-4 py-2">Columna</th>
          <th class="px-4 py-2">Descripción</th>
          <th class="px-4 py-2">Ejemplo</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line text-ink-soft">
        <tr><td class="num px-4 py-2 text-xs">nombre*</td><td class="px-4 py-2">Nombre del producto</td><td class="px-4 py-2">Remera oversized</td></tr>
        <tr><td class="num px-4 py-2 text-xs">sku</td><td class="px-4 py-2">Código único (opcional)</td><td class="px-4 py-2">re-2</td></tr>
        <tr><td class="num px-4 py-2 text-xs">categoria</td><td class="px-4 py-2">Nombre de la categoría (se crea si no existe)</td><td class="px-4 py-2">Ropa</td></tr>
        <tr><td class="num px-4 py-2 text-xs">costo</td><td class="px-4 py-2">Costo (Gs., números)</td><td class="num px-4 py-2">20000</td></tr>
        <tr><td class="num px-4 py-2 text-xs">precio*</td><td class="px-4 py-2">Precio de venta (Gs.)</td><td class="num px-4 py-2">50000</td></tr>
        <tr><td class="num px-4 py-2 text-xs">stock</td><td class="px-4 py-2">Cantidad en existencia</td><td class="num px-4 py-2">100</td></tr>
        <tr><td class="num px-4 py-2 text-xs">minimo</td><td class="px-4 py-2">Stock mínimo para alertas</td><td class="num px-4 py-2">20</td></tr>
        <tr><td class="num px-4 py-2 text-xs">unidad</td><td class="px-4 py-2">Unidad de medida</td><td class="px-4 py-2">unidad / caja / bolsa</td></tr>
      </tbody>
    </table>
  </div>

  <p class="mt-4 text-xs leading-relaxed text-muted">* obligatorio. Las columnas van como encabezados en la primera fila. Antes de importar vas a poder revisar cuántos productos están bien y cuáles tienen errores.</p>

  <div class="my-6 border-t border-line"></div>

  <%= form_with url: imports_path, multipart: true, data: { turbo: false }, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :file, "Archivo (Excel o CSV)", class: label_classes %>
      <%= form.file_field :file, accept: ".csv,.xlsx,.xls,text/csv", required: true, class: "field !py-0 file:mr-3 file:rounded-md file:border-0 file:bg-ink file:px-3 file:py-2 file:text-xs file:font-bold file:uppercase file:tracking-wider file:text-paper hover:file:bg-hazard" %>
    </div>
    <div class="flex items-center justify-end gap-3">
      <%= link_to "Volver", products_path, class: button_classes(:secondary) %>
      <%= form.submit "Revisar y validar", class: button_classes %>
    </div>
  <% end %>
</div>
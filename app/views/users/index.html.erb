<% content_for(:page_title) { "Empleados" } %>

<%= render "shared/page_header", title: "Empleados", subtitle: "Usuarios con acceso a la cuenta", action:
  link_to("Agregar empleado", new_employee_path, class: button_classes) %>

<div class="<%= card_classes %> overflow-hidden">
  <% if @users.any? %>
    <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
        <tr>
          <th class="px-5 py-3">Nombre</th>
          <th class="px-5 py-3">Email</th>
          <th class="px-5 py-3">Rol</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        <% @users.each do |user| %>
          <tr class="transition hover:bg-raise/50">
            <td class="px-5 py-3 font-medium text-ink"><%= user.name %></td>
            <td class="num px-5 py-3 text-muted"><%= user.email %></td>
            <td class="px-5 py-3">
              <% if user.owner? %>
                <span class="badge badge-ink">Dueño</span>
              <% else %>
                <span class="badge badge-neutral">Empleado</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  <% else %>
    <%= render "shared/empty_state", message: "No hay empleados" %>
  <% end %>
</div>
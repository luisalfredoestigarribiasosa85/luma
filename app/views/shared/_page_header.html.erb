<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h2 class="font-display text-2xl font-bold text-ivory"><%= title %></h2>
    <% if local_assigns[:subtitle].present? %>
      <p class="mt-1 text-sm text-muted"><%= subtitle %></p>
    <% end %>
    <div class="ember mt-3 h-px w-16"></div>
  </div>
  <% if local_assigns[:action].present? %>
    <div class="flex items-center gap-3"><%= action %></div>
  <% end %>
</div>
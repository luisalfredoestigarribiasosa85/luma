<% content_for(:page_title) { "Proveedores" } %>

<%= render "shared/page_header", title: "Proveedores", subtitle: "#{@suppliers.count} proveedores", action:
  link_to("Nuevo proveedor", new_supplier_path, class: button_classes) %>

<div class="mb-4">
  <%= form_with url: suppliers_path, method: :get, class: "flex max-w-md gap-2" do |form| %>
    <%= form.text_field :q, value: params[:q], placeholder: "Buscar por nombre o RUC…", class: field_classes %>
    <%= form.submit "Buscar", class: "#{button_classes(:secondary)} cursor-pointer" %>
  <% end %>
</div>

<div class="<%= card_classes %> overflow-hidden">
  <% if @suppliers.any? %>
    <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
        <tr>
          <th class="px-5 py-3">Nombre</th>
          <th class="px-5 py-3">RUC</th>
          <th class="px-5 py-3">Teléfono</th>
          <th class="px-5 py-3">Email</th>
          <th class="px-5 py-3 text-right"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        <% @suppliers.each do |supplier| %>
          <tr class="transition hover:bg-raise/50">
            <td class="px-5 py-3 font-medium text-ink"><%= supplier.name %></td>
            <td class="num px-5 py-3 text-xs text-faint"><%= supplier.ruc.presence || "—" %></td>
            <td class="px-5 py-3 text-muted"><%= supplier.phone.presence || "—" %></td>
            <td class="px-5 py-3 text-muted"><%= supplier.email.presence || "—" %></td>
            <td class="whitespace-nowrap px-5 py-3 text-right">
              <%= link_to "Editar", edit_supplier_path(supplier), class: "text-xs font-semibold uppercase tracking-wider text-bronze hover:text-bronze-deep" %>
              <%= button_to "Eliminar", supplier, method: :delete,
                  data: { turbo_confirm: "¿Eliminar a #{supplier.name}?" },
                  class: "ml-3 inline text-xs font-semibold uppercase tracking-wider text-alert hover:text-alert-dark cursor-pointer" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  <% else %>
    <%= render "shared/empty_state", message: "No hay proveedores todavía" %>
  <% end %>
</div>
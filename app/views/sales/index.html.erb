<% content_for(:page_title) { "Ventas" } %>

<%= render "shared/page_header", title: "Ventas", action: link_to("+ Nueva venta", new_sale_path, class: button_classes) %>

<% if @sales.any? %>
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b border-line bg-raise/50 text-[10px] font-bold uppercase tracking-wider text-muted">
          <th class="px-5 py-3">N°</th>
          <th class="px-5 py-3">Fecha</th>
          <th class="px-5 py-3">Cliente</th>
          <th class="px-5 py-3">Pago</th>
          <th class="px-5 py-3 text-right">Total</th>
          <th class="px-5 py-3 text-right">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        <% @sales.each do |sale| %>
          <tr class="transition hover:bg-raise/50">
            <td class="num px-5 py-3.5 text-faint">#<%= sale.number %></td>
            <td class="num px-5 py-3.5"><%= simple_date(sale.created_at) %></td>
            <td class="px-5 py-3.5 font-medium"><%= sale.customer&.name || "Consumidor final" %></td>
            <td class="px-5 py-3.5">
              <span class="badge <%= sale.payment_method == "credit" ? "badge-warn" : "badge-neutral" %>">
                <%= payment_method_label(sale.payment_method) %>
              </span>
            </td>
            <td class="num px-5 py-3.5 text-right font-semibold"><%= money(sale.total) %></td>
            <td class="px-5 py-3.5 text-right">
              <%= link_to "Ver", sale_path(sale), class: "text-xs font-semibold uppercase tracking-wider text-bronze hover:text-bronze-deep" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
<% else %>
  <%= render "shared/empty_state", message: "No hubo ventas aún" %>
<% end %>
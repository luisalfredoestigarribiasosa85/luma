<% content_for(:page_title) { "Venta ##{@sale.number}" } %>

<%= render "shared/page_header",
  title: "Venta ##{@sale.number}",
  subtitle: "#{simple_date(@sale.created_at)} · Registró: #{@sale.user&.name || "—"}",
  action: "#{link_to('Imprimir ticket', ticket_sale_path(@sale), target: '_blank', class: button_classes)} #{link_to('Volver', sales_path, class: button_classes(:secondary))}".html_safe %>

<div class="grid gap-6 xl:grid-cols-3">
  <div class="<%= card_classes %> overflow-hidden xl:col-span-2">
    <div class="flex items-center justify-between border-b border-line px-5 py-4">
      <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ink">Detalle de la venta</h3>
      <% if @sale.completed? %>
        <span class="badge badge-ok">Completada</span>
      <% else %>
        <span class="badge badge-alert">Anulada</span>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
          <tr>
            <th class="px-5 py-3">Producto</th>
            <th class="px-5 py-3 text-right">Precio</th>
            <th class="px-5 py-3 text-right">Cant.</th>
            <th class="px-5 py-3 text-right">Subtotal</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @sale.items.each do |item| %>
            <tr>
              <td class="px-5 py-3 font-medium text-ink"><%= item.product.name %></td>
              <td class="num px-5 py-3 text-right text-ink-soft"><%= money(item.unit_price) %></td>
              <td class="num px-5 py-3 text-right text-ink-soft"><%= item.quantity %> <%= item.product.unit %></td>
              <td class="num px-5 py-3 text-right font-semibold"><%= money(item.line_subtotal) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="border-t border-line bg-raise/50 px-5 py-4 text-sm">
      <dl class="ml-auto max-w-xs space-y-2 font-mono">
        <div class="flex justify-between"><dt class="text-muted">Subtotal</dt><dd><%= money(@sale.subtotal) %></dd></div>
        <div class="flex justify-between"><dt class="text-muted">Descuento</dt><dd><%= money(@sale.discount) %></dd></div>
        <div class="flex justify-between border-t border-dashed border-line-dark pt-2 font-display text-base font-bold text-ink"><dt>Total</dt><dd class="text-bronze"><%= money(@sale.total) %></dd></div>
      </dl>
    </div>
  </div>

  <div class="space-y-6">
    <div class="<%= card_classes %> p-6">
      <div class="ember mb-4 h-1 w-10"></div>
      <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ink">Datos</h3>
      <dl class="mt-4 space-y-3 text-sm">
        <div class="flex justify-between"><dt class="text-muted">Cliente</dt><dd class="font-medium text-ink"><%= @sale.customer&.name.presence || "Consumidor final" %></dd></div>
        <div class="flex justify-between"><dt class="text-muted">Forma de pago</dt><dd class="font-medium text-ink capitalize"><%= @sale.payment_method %></dd></div>
        <div class="flex justify-between"><dt class="text-muted">Vendedor</dt><dd class="font-medium text-ink"><%= @sale.user&.name || "—" %></dd></div>
        <% if @sale.note.present? %>
          <div class="flex flex-col gap-1"><dt class="text-muted">Nota</dt><dd class="font-medium text-ink"><%= @sale.note %></dd></div>
        <% end %>
      </dl>
    </div>

    <% if @sale.credit? && @sale.completed? %>
      <div class="<%= card_classes %> p-6">
        <div class="flex items-center justify-between">
          <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ink">Saldo pendiente</h3>
          <span class="badge badge-alert"><%= money(@sale.balance) %></span>
        </div>
        <p class="mt-1 text-sm text-muted">Total <%= money(@sale.total) %> · Pagado <%= money(@sale.total - @sale.balance) %></p>
        <% if @sale.payments.any? %>
          <ul class="mt-4 divide-y divide-line">
            <% @sale.payments.order(created_at: :desc).each do |payment| %>
              <li class="flex items-center justify-between py-2 text-sm">
                <div>
                  <span class="font-medium capitalize text-ink"><%= payment.payment_method %></span>
                  <span class="text-muted"> · <%= simple_date(payment.created_at) %></span>
                </div>
                <span class="num font-semibold text-ok"><%= money(payment.amount) %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
        <% if @sale.balance.positive? %>
          <%= link_to "Registrar pago", new_payment_path(customer_id: @sale.customer_id, sale_id: @sale.id), class: "#{button_classes} mt-4 w-full" %>
        <% end %>
      </div>
    <% end %>

    <% if @sale.completed? %>
      <div class="<%= card_classes %> p-6">
        <h3 class="font-display text-sm font-bold uppercase tracking-wide text-alert">Anular venta</h3>
        <p class="mt-2 text-sm text-muted">Se restaura el stock de todos los productos de esta venta.</p>
        <%= button_to "Anular venta", cancel_sale_path(@sale), method: :patch,
            data: { turbo_confirm: "¿Anular la venta ##{@sale.number}? Se restaurará el stock." },
            class: "#{button_classes(:danger)} mt-4 w-full" %>
      </div>
    <% end %>
  </div>
</div>
<% content_for(:page_title) { "Configuración" } %>

<%= render "shared/page_header", title: "Configuración", subtitle: "Datos de #{current_account.name} y del ticket" %>

<%= render "shared/form_errors", object: @account %>

<%= form_with model: @account, url: settings_path, method: :patch, class: "max-w-xl space-y-6" do |form| %>
  <div class="<%= card_classes %> p-6">
    <div class="ember mb-4 h-1 w-10"></div>
    <div class="space-y-4">
      <div>
        <%= form.label :name, "Nombre de la tienda", class: label_classes %>
        <%= form.text_field :name, class: field_classes %>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :phone, "Teléfono", class: label_classes %>
          <%= form.text_field :phone, class: field_classes, placeholder: "0981 123 456" %>
        </div>
        <div>
          <%= form.label :address, "Dirección", class: label_classes %>
          <%= form.text_field :address, class: field_classes, placeholder: "Av. Principal 123" %>
        </div>
      </div>
    </div>
  </div>

  <div class="<%= card_classes %> p-6">
    <div class="ember mb-4 h-1 w-10"></div>
    <div>
      <%= form.label :ticket_footer, "Mensaje del ticket", class: label_classes %>
      <%= form.text_area :ticket_footer, rows: 2, class: field_classes,
            placeholder: "Ej: Los precios pueden variar sin previo aviso" %>
      <p class="mt-1 text-xs text-faint">Se muestra al pie del recibo, debajo del agradecimiento.</p>
    </div>
  </div>

  <div class="flex gap-3">
    <%= link_to "Cancelar", root_path, class: button_classes(:secondary) %>
    <%= form.submit "Guardar", class: button_classes %>
  </div>
<% end %>
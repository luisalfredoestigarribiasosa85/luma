<% content_for(:page_title) { "Nueva compra" } %>
<% catalog = @products.map { |p| { id: p.id, name: p.name, price: p.cost_price, unit: p.unit, stock: p.stock } }.to_json %>

<script type="application/json" id="sale-catalog" data-turbo-cache="false"><%= raw json_escape catalog %></script>

<%= render "shared/form_errors", object: @purchase %>

<%= form_with model: @purchase, data: { controller: "sales" }, class: "grid items-start gap-6 xl:grid-cols-3" do |form| %>
  <div class="<%= card_classes %> p-6 xl:col-span-2">
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :supplier_id, "Proveedor", class: label_classes %>
        <%= form.collection_select :supplier_id, @suppliers, :id, :name, { include_blank: "Seleccionar proveedor" }, class: field_classes %>
      </div>
    </div>

    <p class="eyebrow mt-7">Productos de la compra</p>

    <div class="mt-3 hidden grid-cols-12 gap-2 px-1 text-[10px] font-bold uppercase tracking-wider text-faint sm:grid">
      <div class="col-span-6">Producto</div>
      <div class="col-span-2">Cant.</div>
      <div class="col-span-2">Costo unit.</div>
      <div class="col-span-2 text-right">Subtotal</div>
    </div>

    <div data-sales-target="lines" class="mt-2 space-y-2">
      <%= form.fields_for :items, @purchase.items do |item_form| %>
        <%= render "purchases/item_fields", f: item_form %>
      <% end %>
    </div>

    <button type="button" data-action="sales#addLine" class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-bronze hover:text-bronze-deep">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      Agregar producto
    </button>

    <template data-sales-target="template">
      <%= form.fields_for :items, PurchaseItem.new, child_index: "__INDEX__" do |item_form| %>
        <%= render "purchases/item_fields", f: item_form %>
      <% end %>
    </template>

    <div class="mt-6">
      <%= form.label :note, "Nota", class: label_classes %>
      <%= form.text_area :note, rows: 2, placeholder: "Comentario interno (no afecta el total)", class: field_classes %>
    </div>
  </div>

  <div class="<%= card_classes %> overflow-hidden xl:col-span-1">
    <div class="ember h-1.5"></div>
    <div class="p-6">
      <p class="eyebrow">Resumen de la compra</p>

      <dl class="mt-4 space-y-3 font-mono text-sm">
        <div class="flex justify-between">
          <dt class="text-muted">Artículos</dt>
          <dd data-sales-target="summaryCount" class="num font-semibold">0</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-muted">Subtotal</dt>
          <dd data-sales-target="summarySubtotal" class="num font-semibold">0</dd>
        </div>
        <div class="mt-4 flex items-end justify-between border-t border-dashed border-line-dark pt-4">
          <dt class="font-display text-sm font-bold uppercase tracking-wider text-ink">Total</dt>
          <dd data-sales-target="summaryTotal" class="num font-display text-2xl font-bold text-bronze">0</dd>
        </div>
      </dl>

      <div class="mt-7 flex flex-col gap-3">
        <%= form.submit "Registrar compra", class: "#{button_classes} w-full", data: { turbo_submits_with: "Guardando…" } %>
        <%= link_to "Cancelar", purchases_path, class: "#{button_classes(:secondary)} w-full" %>
      </div>

      <p class="mt-5 border-t border-line pt-4 text-xs leading-relaxed text-faint">El costo se carga automáticamente y el stock se suma al registrar la compra.</p>
    </div>
  </div>
<% end %>
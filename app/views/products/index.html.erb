<% content_for(:page_title) { "Productos" } %>

<%= render "shared/page_header", title: "Productos", subtitle: "#{@products.unscope(:limit).count} registros", action:
  link_to("Nuevo producto", new_product_path, class: button_classes) %>

<div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
  <div>
    <%= link_to "Importar desde Excel", new_import_path, class: "text-sm font-semibold uppercase tracking-wider text-bronze hover:text-bronze-deep" %>
  </div>
  <div class="flex flex-1 gap-2 sm:justify-end">
    <%= form_with url: products_path, method: :get, class: "flex flex-1 gap-2 sm:max-w-2xl" do |form| %>
      <%= form.text_field :q, value: params[:q], placeholder: "Buscar por nombre o código…", class: field_classes %>
      <%= form.select :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), { include_blank: "Todas las categorías" }, class: field_classes %>
      <%= form.submit "Filtrar", class: "#{button_classes(:secondary)} cursor-pointer" %>
    <% end %>
  </div>
</div>

<div class="<%= card_classes %> overflow-hidden">
  <% if @products.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-raise/50 text-left text-[10px] font-bold uppercase tracking-wider text-muted">
          <tr>
            <th class="px-5 py-3">Código</th>
            <th class="px-5 py-3">Producto</th>
            <th class="px-5 py-3">Categoría</th>
            <th class="px-5 py-3 text-right">Precio</th>
            <th class="px-5 py-3 text-right">Stock</th>
            <th class="px-5 py-3">Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @products.each do |product| %>
            <tr class="transition hover:bg-raise/50">
              <td class="num px-5 py-3 text-xs text-faint"><%= product.sku.presence || "—" %></td>
              <td class="px-5 py-3">
                <%= link_to product.name, product, class: "font-medium text-ink hover:text-bronze" %>
              </td>
              <td class="px-5 py-3 text-muted"><%= product.category&.name || "—" %></td>
              <td class="num px-5 py-3 text-right font-medium"><%= money(product.price) %></td>
              <td class="num px-5 py-3 text-right">
                <span class="<%= product.low_stock? ? "font-bold text-alert" : "text-ink-soft" %>">
                  <%= product.stock %> <%= product.unit %>
                </span>
              </td>
              <td class="px-5 py-3">
                <% if product.active? %>
                  <span class="badge badge-ok">Activo</span>
                <% else %>
                  <span class="badge badge-neutral">Inactivo</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "shared/empty_state", message: "No hay productos. ¡Creá tu primer producto!" %>
  <% end %>
</div>